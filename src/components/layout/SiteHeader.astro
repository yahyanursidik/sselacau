---
import { Image } from 'astro:assets';
import { brandAssets } from '../../config/brand';
import { mainNav, site, unitList } from '../../config/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const unitActive = unitList.some((u) => path.startsWith(u.url));
---

<header class="site-header">
  <div class="container bar">
    <a class="identity" href="/">
      <Image
        src={brandAssets.site.src}
        alt=""
        width={52}
        densities={[1, 2]}
        loading="eager"
        class="identity-logo"
      />
      <span>
        <strong>{site.shortName}</strong>
        <small>{site.locality}</small>
      </span>
      <span class="visually-hidden">(beranda)</span>
    </a>

    <nav class="nav" aria-label="Navigasi utama">
      <ul class="nav-list">
        {
          mainNav.map((item) =>
            item.href ? (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ) : (
              <li class="drop" data-drop>
                <button
                  type="button"
                  class:list={['drop-toggle', { active: unitActive }]}
                  aria-expanded="false"
                  aria-controls="menu-unit"
                >
                  {item.label}
                  <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12">
                    <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" />
                  </svg>
                </button>
                <ul class="drop-menu" id="menu-unit" hidden>
                  {unitList.map((u) => (
                    <li>
                      <a href={u.url} aria-current={path.startsWith(u.url) ? 'page' : undefined}>
                        <Image src={brandAssets[u.key].src} alt="" width={44} densities={[1, 2]} />
                        <span>
                          {u.officialName}
                          <small>{u.descriptor}</small>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <a class="btn btn--primary nav-cta" href="/pendaftaran/">Informasi Pendaftaran</a>

    <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="menu-mobile">
      <span class="menu-toggle-label">Menu</span>
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20">
        <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.8" />
      </svg>
    </button>
  </div>

  <nav class="mobile-panel" id="menu-mobile" aria-label="Navigasi utama (seluler)" hidden>
    <ul class="container">
      {
        mainNav.map((item) =>
          item.href ? (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ) : (
            unitList.map((u) => (
              <li>
                <a class="sub" href={u.url} aria-current={path.startsWith(u.url) ? 'page' : undefined}>
                  {u.officialName}
                </a>
              </li>
            ))
          ),
        )
      }
      <li>
        <a class="btn btn--primary" href="/pendaftaran/">Informasi Pendaftaran</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  function setup() {
    const drop = document.querySelector<HTMLElement>('[data-drop]');
    const dropBtn = drop?.querySelector<HTMLButtonElement>('.drop-toggle');
    const dropMenu = drop?.querySelector<HTMLElement>('.drop-menu');

    const setDrop = (open: boolean) => {
      if (!dropBtn || !dropMenu) return;
      dropBtn.setAttribute('aria-expanded', String(open));
      dropMenu.hidden = !open;
    };

    dropBtn?.addEventListener('click', () => setDrop(dropBtn.getAttribute('aria-expanded') !== 'true'));
    drop?.addEventListener('focusout', (e) => {
      if (!drop.contains(e.relatedTarget as Node | null)) setDrop(false);
    });
    document.addEventListener('click', (e) => {
      if (drop && !drop.contains(e.target as Node)) setDrop(false);
    });

    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const panel = document.getElementById('menu-mobile');
    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      if (panel) panel.hidden = !open;
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (dropBtn?.getAttribute('aria-expanded') === 'true') {
        setDrop(false);
        dropBtn.focus();
      }
      if (toggle?.getAttribute('aria-expanded') === 'true') {
        toggle.setAttribute('aria-expanded', 'false');
        if (panel) panel.hidden = true;
        toggle.focus();
      }
    });
  }

  setup();
</script>

<style>
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 80px;
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--text);
    flex-shrink: 0;
  }

  .identity-logo {
    width: 52px;
    height: 57px;
    object-fit: contain;
  }

  .identity strong {
    display: block;
    font-size: 1rem;
    line-height: 1.25;
    color: var(--brand-deep);
  }

  .identity small {
    display: block;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .nav {
    flex: 1;
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-list > li > a,
  .drop-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    padding: 0 0.6rem;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    background: none;
    border: 0;
    border-radius: 6px;
    cursor: pointer;
    white-space: nowrap;
  }

  .nav-list > li > a:hover,
  .drop-toggle:hover {
    color: var(--brand-deep);
    background: var(--wash);
  }

  .nav-list > li > a:active,
  .drop-toggle:active,
  .drop-menu a:active,
  .menu-toggle:active {
    background: #e4e8dc;
  }

  .nav-list > li > a[aria-current='page'],
  .drop-toggle.active {
    color: var(--brand);
    box-shadow: inset 0 -2px 0 var(--brand);
    border-radius: 0;
  }

  .drop {
    position: relative;
  }

  .drop-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .drop-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: -1rem;
    width: 320px;
    list-style: none;
    margin: 0;
    padding: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: 0 12px 32px rgb(32 40 32 / 0.1);
  }

  .drop-menu a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.6rem;
    border-radius: 6px;
    text-decoration: none;
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .drop-menu a:hover,
  .drop-menu a[aria-current='page'] {
    background: var(--wash);
  }

  .drop-menu img {
    width: 44px;
    height: 44px;
    object-fit: contain;
  }

  .drop-menu small {
    display: block;
    font-weight: 400;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .nav-cta {
    flex-shrink: 0;
    font-size: 0.875rem;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 0.85rem;
    margin-left: auto;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--control-border);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .menu-toggle:hover {
    background: var(--wash);
  }

  .mobile-panel {
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .mobile-panel ul {
    list-style: none;
    margin: 0;
    padding-block: 0.5rem 1.25rem;
  }

  .mobile-panel li a:not(.btn) {
    display: block;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
  }

  .mobile-panel li a.sub {
    padding-left: 1.25rem;
    font-weight: 500;
    color: var(--brand-deep);
  }

  .mobile-panel a[aria-current='page'] {
    color: var(--brand);
  }

  .mobile-panel .btn {
    margin-top: 1rem;
    width: 100%;
  }

  @media (max-width: 1080px) {
    .nav-cta {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .nav {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .bar {
      min-height: 68px;
    }

    .identity-logo {
      width: 44px;
      height: 48px;
    }

    .bar {
      gap: 0.75rem;
    }

    .identity {
      flex-shrink: 1;
      min-width: 0;
    }
  }

  @media (max-width: 420px) {
    .menu-toggle-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .identity strong {
      font-size: 0.9375rem;
    }
  }

  @media (min-width: 901px) {
    .mobile-panel {
      display: none;
    }
  }
</style>
