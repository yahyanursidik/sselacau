---
interface Props {
  vision: string;
  mission: string[];
}

const { vision, mission } = Astro.props;
---

<section class="section section--white" aria-labelledby="visi-title">
  <div class="container two-col">
    <h2 id="visi-title">Visi dan misi</h2>
    <div>
      <h3>Visi</h3>
      <p class="vision">{vision}</p>
      <h3>Misi</h3>
      <ol>{mission.map((m) => <li>{m}</li>)}</ol>
    </div>
  </div>
</section>

<style>
  .two-col {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
  }

  .two-col > div {
    max-width: 42rem;
  }

  h3 {
    font-size: 1rem;
    color: var(--brand);
    margin: 0 0 0.5rem;
  }

  .vision {
    font-size: clamp(1.15rem, 2vw, 1.375rem);
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  ol {
    padding-left: 1.3rem;
    margin: 0;
  }

  li + li {
    margin-top: 0.6rem;
  }

  @media (max-width: 760px) {
    .two-col {
      grid-template-columns: 1fr;
    }
  }
</style>
