---
import WaButton from './WaButton.astro';
import { enrollmentLabel, type Unit } from '../../config/site';

interface Props {
  unit: Unit;
}

const { unit } = Astro.props;
---

<section class="section section--wash" aria-labelledby={`daftar-${unit.key}`}>
  <div class="container enroll">
    <div>
      <h2 id={`daftar-${unit.key}`}>Pendaftaran {unit.officialName}</h2>
      <p class="muted">
        Status: <strong>{enrollmentLabel[unit.enrollment]}</strong>.
        {
          unit.contact ? (
            <>
              Jadwal, syarat dan biaya dapat ditanyakan langsung melalui WhatsApp{' '}
              <a href={unit.contact.url} target="_blank" rel="noopener noreferrer">{unit.contact.phone}</a>.
            </>
          ) : (
            'Jadwal, syarat dan biaya diumumkan langsung oleh unit.'
          )
        }{' '}
        Website ini tidak menerima formulir pendaftaran.
      </p>
    </div>
    <div class="actions">
      {unit.contact && <WaButton contact={unit.contact} />}
      <a class:list={['btn', unit.contact ? 'btn--secondary' : 'btn--primary']} href="/pendaftaran/">Informasi Pendaftaran</a>
    </div>
  </div>
</section>

<style>
  .enroll {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem 3rem;
  }

  .enroll > div:first-child {
    max-width: 38rem;
  }

  h2 {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
  }

  p {
    margin: 0;
  }
</style>
