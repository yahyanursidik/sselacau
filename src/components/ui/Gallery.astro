---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface GalleryItem {
  src: ImageMetadata;
  alt: string;
  caption: string;
  /** Foto lanskap: dua kolom, rasio 8:5. */
  wide?: boolean;
}

interface Props {
  items: GalleryItem[];
  /** Label untuk dialog pembesar foto. */
  label: string;
}

const { items, label } = Astro.props;
const full = await Promise.all(items.map((i) => getImage({ src: i.src, width: 1200, format: 'webp' })));
---

<ul class="gallery" data-gallery>
  {
    items.map((item, n) => (
      <li class:list={{ wide: item.wide }}>
        <figure>
          <button
            type="button"
            class="open"
            data-full={full[n]!.src}
            data-alt={item.alt}
            data-caption={item.caption}
            aria-label={`Perbesar foto: ${item.caption}`}
          >
            <Image src={item.src} alt={item.alt} width={item.wide ? 760 : 380} densities={[1, 2]} />
          </button>
          <figcaption>{item.caption}</figcaption>
        </figure>
      </li>
    ))
  }
</ul>

<dialog class="viewer" aria-label={label}>
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
  <button type="button" class="close">Tutup</button>
</dialog>

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const dialog = gallery.nextElementSibling as HTMLDialogElement | null;
    if (!dialog) continue;
    const img = dialog.querySelector('img')!;
    const caption = dialog.querySelector('figcaption')!;
    let opener: HTMLElement | null = null;

    gallery.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button.open');
      if (!btn) return;
      opener = btn;
      img.src = btn.dataset.full ?? '';
      img.alt = btn.dataset.alt ?? '';
      caption.textContent = btn.dataset.caption ?? '';
      dialog.showModal();
    });

    dialog.querySelector('.close')?.addEventListener('click', () => dialog.close());
    // Klik di luar foto (di area backdrop) menutup dialog
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => opener?.focus());
  }
</script>

<style>
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-flow: dense;
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  .wide {
    grid-column: span 2;
  }

  figure {
    margin: 0;
  }

  .open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 10px;
    overflow: hidden;
    background: var(--wash);
  }

  .open :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  .wide .open :global(img) {
    aspect-ratio: 8 / 5;
  }

  .open:hover :global(img) {
    transform: scale(1.03);
  }

  .open:active :global(img) {
    transform: scale(1.01);
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--brand-deep);
  }

  .viewer {
    max-width: min(92vw, 900px);
    max-height: 92vh;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: var(--surface);
  }

  .viewer::backdrop {
    background: rgb(20 28 20 / 0.82);
  }

  .viewer figure {
    margin: 0;
  }

  .viewer img {
    display: block;
    width: 100%;
    max-height: 78vh;
    object-fit: contain;
    background: #111;
  }

  .viewer figcaption {
    margin: 0;
    padding: 0.85rem 1.25rem;
    font-size: 1rem;
  }

  .close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    min-height: 44px;
    padding: 0 1rem;
    font: inherit;
    font-weight: 650;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--control-border);
    border-radius: var(--radius);
  }

  .close:hover {
    background: var(--wash);
  }

  .close:active {
    background: #e4e8dc;
  }

  @media (max-width: 760px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
