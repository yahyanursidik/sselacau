---
interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Beranda</a></li>
    {
      items.map((item) => (
        <li>{item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: -0.6rem 0 1.15rem;
    padding: 0;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 0.35rem;
    color: #a3aa9f;
  }

  .crumbs ol {
    align-items: center;
  }

  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
  }
</style>
