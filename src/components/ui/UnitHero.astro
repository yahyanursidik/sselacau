---
import Breadcrumbs from './Breadcrumbs.astro';
import UnitLogo from './UnitLogo.astro';
import Mark from './Mark.astro';
import type { Unit } from '../../config/site';

interface Props {
  unit: Unit;
  lead: string;
}

const { unit, lead } = Astro.props;
---

<section class="unit-hero section--white">
  <div class="container">
    <Breadcrumbs items={[{ label: 'Unit Pendidikan' }, { label: unit.officialName }]} />
    <div class="inner">
      <div>
        <Mark />
        <p class="descriptor">{unit.descriptor}</p>
        <h1>{unit.officialName}</h1>
        <p class="lead">{lead}</p>
        <div class="actions">
          <slot name="actions" />
        </div>
      </div>
      <div class="logo-panel">
        <UnitLogo unit={unit.key} size={170} eager />
      </div>
    </div>
  </div>
</section>

<style>
  .unit-hero {
    padding-block: 2rem clamp(3rem, 7vw, 4.5rem);
    border-bottom: 1px solid var(--line);
  }

  .inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 6vw, 4rem);
    align-items: center;
  }

  .descriptor {
    font-weight: 650;
    color: var(--accent-text);
    margin-bottom: 0.5rem;
  }

  .logo-panel {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 240px;
    padding: 2rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .logo-panel :global(.unit-logo) {
    object-position: center;
  }

  @media (max-width: 760px) {
    .inner {
      grid-template-columns: 1fr;
    }

    .logo-panel {
      order: -1;
      min-height: 0;
      padding: 1.5rem;
      justify-content: flex-start;
      background: none;
      border: 0;
      padding: 0;
    }

    .logo-panel :global(.unit-logo) {
      height: calc(var(--h) * 0.65);
      object-position: left center;
    }
  }
</style>
