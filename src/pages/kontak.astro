---
import PageLayout from '../layouts/PageLayout.astro';
import Pending from '../components/ui/Pending.astro';
import { site, unitList, kuttabAddress } from '../config/site';

const { contact } = site;
const noContact = unitList.filter((u) => !u.contact).map((u) => u.officialName);
---

<PageLayout
  title="Kontak & Lokasi"
  description="Kontak dan lokasi Sekolah Tarbiyah Sunnah di Selacau, Batujajar, Kabupaten Bandung Barat."
  lead={`Sekolah berada di ${site.region}, Jawa Barat.`}
>
  <div class="grid">
    <section aria-labelledby="alamat">
      <h2 id="alamat">Alamat</h2>
      <p>
        <strong>Kuttab Tarbiyah Sunnah</strong><br />
        {kuttabAddress}
      </p>
      <p class="muted small">Sumber: sampul KOSP Kuttab 2026/2027.</p>
      {
        contact.mapsUrl ? (
          <a class="btn btn--secondary" href={contact.mapsUrl}>
            Buka di Google Maps
          </a>
        ) : (
          <Pending>Alamat TK dan Madrasah, serta titik peta yang tepat.</Pending>
        )
      }
    </section>

    <section aria-labelledby="hubungi">
      <h2 id="hubungi">Hubungi unit</h2>
      <ul class="contacts">
        {
          unitList.map((u) => (
            <li>
              <span>
                {u.officialName}
                {u.contact && <small>{u.contact.label}</small>}
              </span>
              {u.contact ? (
                <a href={u.contact.url} target="_blank" rel="noopener noreferrer">
                  WhatsApp {u.contact.phone}
                </a>
              ) : (
                <span class="muted">Belum dicantumkan</span>
              )}
            </li>
          ))
        }
      </ul>
      {
        noContact.length > 0 && (
          <Pending>Kontak WhatsApp resmi {noContact.join(' dan ')}. Jangan memakai nomor pribadi tanpa izin.</Pending>
        )
      }
    </section>
  </div>
</PageLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 4.5rem);
  }

  h2 {
    font-size: 1.5rem;
  }

  .small {
    font-size: 0.875rem;
  }

  .contacts {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
  }

  .contacts li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.25rem 1rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .contacts small {
    display: block;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .contacts a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 650;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
