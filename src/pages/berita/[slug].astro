---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import { units } from '../../config/site';

export async function getStaticPaths() {
  const news = await getCollection('news', ({ data }) => data.published);
  return news.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'news'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const fmt = new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
const unit = entry.data.unit === 'umum' ? 'Umum' : units[entry.data.unit].shortName;
---

<PageLayout
  title={entry.data.title}
  description={entry.data.excerpt}
  crumbs={[{ label: 'Berita', href: '/berita/' }, { label: entry.data.title }]}
>
  <article class="prose">
    <p class="meta">
      {unit} · <time datetime={entry.data.date.toISOString()}>{fmt.format(entry.data.date)}</time>
    </p>
    {entry.data.image && <Image src={entry.data.image} alt={entry.data.imageAlt ?? ''} width={840} loading="eager" />}
    <Content />
  </article>
</PageLayout>

<style>
  .meta {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  article :global(img) {
    border-radius: var(--radius);
    margin-block: 1.5rem;
  }
</style>
