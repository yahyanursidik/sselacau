---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import { units } from '../config/site';

const activities = (await getCollection('activities', ({ data }) => data.published)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
---

<PageLayout
  title="Kehidupan Sekolah"
  description="Dokumentasi kegiatan TK, Kuttab dan Madrasah Tarbiyah Sunnah di Selacau."
  lead="Dokumentasi kegiatan yang sudah berlangsung, diberi label sesuai unitnya."
>
  {
    activities.length ? (
      <ul class="activities">
        {activities.map((a) => (
          <li>
            {a.data.cover && (
              <Image src={a.data.cover} alt={a.data.coverAlt ?? ''} width={560} class="cover" />
            )}
            <p class="meta">
              <span>{units[a.data.unit].shortName}</span> ·{' '}
              <time datetime={a.data.date.toISOString()}>{fmt.format(a.data.date)}</time>
            </p>
            <h2>{a.data.title}</h2>
            <p class="muted">{a.data.description}</p>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">
        Dokumentasi kegiatan belum diterbitkan. Foto dan cerita kegiatan dari ketiga unit akan dimuat di halaman ini.
      </p>
    )
  }
</PageLayout>

<style>
  .activities {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 2.5rem 2rem;
  }

  .cover {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 1rem;
  }

  .meta {
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 0.35rem;
  }

  .meta span {
    font-weight: 650;
    color: var(--brand-deep);
  }

  h2 {
    font-size: 1.2rem;
  }
</style>
