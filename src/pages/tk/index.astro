---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import UnitHero from '../../components/ui/UnitHero.astro';
import Gallery, { type GalleryItem } from '../../components/ui/Gallery.astro';
import VisionMission from '../../components/ui/VisionMission.astro';
import ScheduleBox from '../../components/ui/ScheduleBox.astro';
import WaButton from '../../components/ui/WaButton.astro';
import { units, enrollmentLabel } from '../../config/site';
import kelasSuasana from '../../assets/tk/kelas-suasana.jpg';
import kelasLembar from '../../assets/tk/kelas-lembar-kegiatan.jpg';
import kelasGuru from '../../assets/tk/kelas-guru.jpg';
import mplsBalon from '../../assets/tk/mpls-balon.jpg';
import mplsTangan from '../../assets/tk/mpls-angkat-tangan.jpg';
import funCooking from '../../assets/tk/fun-cooking-memetik-sayur.jpg';
import outingSawah from '../../assets/tk/outing-class-sawah.jpg';
import luarKelas from '../../assets/tk/luar-kelas-taman.jpg';
import kunjunganRadio from '../../assets/tk/kunjungan-radio.jpg';
import jalanSawah from '../../assets/tk/jalan-sawah.jpg';

// Sumber isi halaman: "Program Pembelajaran TK Tarbiyah Sunnah" dari pengguna (30 Oktober 2026) dan
// dokumen "informasi TK untuk data pada Website" (6 November 2026), termasuk foto kegiatan.
const unit = units.tk;

const profile =
  'TK Tarbiyah Sunnah adalah lembaga pendidikan anak usia dini yang mendampingi anak tumbuh dan belajar dalam suasana yang islami, hangat, menyenangkan, dan sesuai dengan tahap perkembangan anak. Pembelajaran mengutamakan pembiasaan adab, nilai-nilai Islam, kemandirian, serta pengalaman belajar melalui bermain dan kegiatan nyata.';

const groups = [
  {
    name: 'TK A',
    age: '4–5 tahun',
    text: 'Anak mulai belajar beradaptasi dengan lingkungan sekolah, membangun kemandirian, mengenal adab dan kebiasaan baik, serta belajar melalui berbagai kegiatan bermain dan eksplorasi.',
  },
  {
    name: 'TK B',
    age: '5–6 tahun',
    text: 'Anak mengembangkan kemandirian, kemampuan berkomunikasi, sosial-emosional, kreativitas, serta berbagai keterampilan melalui kegiatan bermain, eksplorasi, dan pengalaman nyata sebagai persiapan menuju jenjang pendidikan berikutnya.',
  },
];

const visi =
  'Mewujudkan anak usia dini yang berakhlak mulia, beriman dan beraqidah Ahlus Sunnah wal Jama’ah, serta mandiri, cerdas, kreatif, dan percaya diri.';

const misi = [
  'Menyelenggarakan pendidikan Islam berdasarkan Al-Qur’an dan Sunnah sesuai dengan perkembangan anak.',
  'Menyiapkan anak didik dengan aktivitas kecakapan hidup (life skill).',
  'Menanamkan Aqidah, Akhlak, dan Muamalah sesuai dengan pemahaman Rasulullah shallallahu ‘alaihi wa sallam dan para sahabatnya.',
];

const areas = [
  {
    name: 'Nilai Agama & Budi Pekerti',
    text: 'Mengenal Allah dan ajaran Islam, pembiasaan doa sehari-hari, Iqro, hafalan surat pendek dan hadits, serta pembiasaan adab dan akhlak dalam kehidupan sehari-hari.',
  },
  {
    name: 'Bahasa & Komunikasi',
    text: 'Mendengarkan cerita, bercakap-cakap, bercerita, mengenal huruf dan bunyinya, serta menumbuhkan minat anak terhadap buku dan kegiatan keaksaraan.',
  },
  {
    name: 'Berhitung & Eksplorasi',
    text: 'Mengenal angka, bentuk, ukuran, warna, pola, dan konsep sederhana melalui permainan serta kegiatan mengamati dan mencoba.',
  },
  {
    name: 'Seni & Kreativitas',
    text: 'Menggambar, mewarnai, membuat karya, serta berbagai kegiatan seni untuk mengembangkan kreativitas dan ekspresi anak.',
  },
  {
    name: 'Sosial-Emosional & Kemandirian',
    text: 'Belajar berbagi, bekerja sama, mengikuti aturan sederhana, mengenali dan mengungkapkan perasaan, menjaga diri dan lingkungan, serta melakukan kegiatan sehari-hari secara bertahap dan mandiri.',
  },
  {
    name: 'Motorik & Kesehatan',
    text: 'Berbagai permainan dan aktivitas yang melatih gerak tubuh, keseimbangan, koordinasi, serta keterampilan tangan, disertai pembiasaan hidup bersih dan sehat.',
  },
];

const themes = ['Diriku', 'Keluargaku', 'Lingkungan', 'Tanaman', 'Binatang', 'Kebutuhan sehari-hari'];
const realActivities = ['Fun cooking', 'Market day', 'Outing class', 'Field trip', 'Proyek sederhana'];

const requirements = [
  'Mengisi formulir pendaftaran.',
  'Melampirkan fotokopi Kartu Keluarga (KK).',
  'Melampirkan fotokopi Akta Kelahiran.',
  'Melampirkan pas foto calon murid.',
  'Membayar biaya pendaftaran.',
  'Mengikuti kegiatan observasi atau pengenalan calon murid sesuai jadwal yang ditentukan sekolah.',
];

// Hanya foto tanpa wajah anak yang jelas; foto lain menunggu konfirmasi izin orang tua.
const photos: GalleryItem[] = [
  { src: kelasGuru, alt: 'Guru menjelaskan di depan kelas, anak-anak duduk berkelompok di meja warna-warni', caption: 'Belajar di kelas', wide: true },
  { src: kelasLembar, alt: 'Tangan anak-anak mengerjakan lembar kegiatan berhitung di meja kelas', caption: 'Lembar kegiatan' },
  { src: mplsBalon, alt: 'Anak-anak berjalan membawa balon warna-warni di halaman sekolah', caption: 'MPLS' },
  { src: mplsTangan, alt: 'Anak-anak mengangkat tangan dengan semangat di dalam kelas', caption: 'MPLS di kelas' },
  { src: funCooking, alt: 'Anak-anak duduk melingkar memetik daun sayuran ke dalam baskom', caption: 'Fun cooking' },
  { src: outingSawah, alt: 'Seorang anak memegang traktor tangan di lahan sawah yang baru diolah', caption: 'Outing class' },
  { src: luarKelas, alt: 'Anak-anak belajar di bawah pohon rindang di halaman sekolah', caption: 'Belajar di luar kelas', wide: true },
  { src: kunjunganRadio, alt: 'Anak-anak berbaris di halaman gedung Radio Tarbiyah Sunnah', caption: 'Kunjungan ke Radio Tarbiyah Sunnah' },
  { src: jalanSawah, alt: 'Anak-anak berjalan beriringan di pematang sawah pada pagi hari', caption: 'Jalan pagi ke sawah' },
];
---

<BaseLayout
  title="TK Tarbiyah Sunnah"
  description="TK Tarbiyah Sunnah di Selacau, Batujajar: pendidikan anak usia dini untuk usia 4–6 tahun (TK A dan TK B), belajar Senin–Jumat pukul 07.30–10.30."
>
  <UnitHero unit={unit} lead={profile}>
    <Fragment slot="actions">
      <a class="btn btn--primary" href="#pembelajaran">Program Pembelajaran</a>
      {unit.contact && <WaButton contact={unit.contact} variant="secondary" />}
      <a class="btn btn--secondary" href="#pendaftaran-tk">Syarat Pendaftaran</a>
    </Fragment>
  </UnitHero>

  <section class="section" aria-labelledby="usia-title">
    <div class="container">
      <h2 id="usia-title">Kelompok usia dan waktu belajar</h2>
      <p class="lead">TK Tarbiyah Sunnah menerima anak dalam dua kelompok usia.</p>

      <div class="groups">
        {
          groups.map((g) => (
            <section class="group" aria-labelledby={`grup-${g.name.replace(' ', '-')}`}>
              <h3 id={`grup-${g.name.replace(' ', '-')}`}>
                {g.name}
                <span class="age">Usia {g.age}</span>
              </h3>
              <p>{g.text}</p>
            </section>
          ))
        }
        <div class="schedule-slot">
          <ScheduleBox days="Senin–Jumat" hours="07.30–10.30" />
        </div>
      </div>

      <p class="muted note">
        Kegiatan pembelajaran pada setiap kelompok disesuaikan dengan usia, tahap perkembangan, dan kebutuhan anak.
      </p>
    </div>
  </section>

  <VisionMission vision={visi} mission={misi} />

  <section class="section" aria-labelledby="lingkungan-title">
    <div class="container split">
      <Image
        src={kelasSuasana}
        alt="Ruang kelas TK dengan meja dan kursi warna-warni, anak-anak menghadap guru di depan papan tulis"
        width={560}
        densities={[1, 2]}
        class="split-photo"
      />
      <div>
        <h2 id="lingkungan-title">Lingkungan belajar dan kurikulum</h2>
        <h3>Lingkungan belajar</h3>
        <p>
          TK Tarbiyah Sunnah menghadirkan lingkungan belajar yang aman, nyaman, dan menyenangkan bagi anak usia dini.
          Pembelajaran dirancang melalui kegiatan bermain sambil belajar, praktik langsung, eksplorasi, dan pembiasaan
          positif.
        </p>
        <h3>Kurikulum</h3>
        <p>
          Kurikulum yang diterapkan merupakan perpaduan kurikulum pemerintah melalui Dinas Pendidikan dengan pendidikan
          Islam yang menjadi kekhasan sekolah. Pembelajaran dikemas secara tematik dan disesuaikan dengan tahap
          perkembangan anak.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--white" id="pembelajaran" aria-labelledby="belajar-title">
    <div class="container">
      <h2 id="belajar-title">Program pembelajaran</h2>
      <p class="lead">
        Kegiatan pembelajaran di TK Tarbiyah Sunnah dilakukan melalui bermain, bercerita, praktik, eksplorasi, dan
        pembiasaan yang disesuaikan dengan usia dan tahap perkembangan anak.
      </p>

      <dl class="areas">
        {
          areas.map((a) => (
            <div>
              <dt>{a.name}</dt>
              <dd>{a.text}</dd>
            </div>
          ))
        }
      </dl>

      <section class="thematic" aria-labelledby="tematik-title">
        <div>
          <h3 id="tematik-title">Kegiatan tematik dan pengalaman nyata</h3>
          <p>
            Anak belajar melalui tema yang dekat dengan kehidupannya. Setiap tema dikembangkan melalui kegiatan dan
            proyek sederhana.
          </p>
        </div>
        <div class="thematic-lists">
          <div>
            <h4>Contoh tema</h4>
            <ul>{themes.map((t) => <li>{t}</li>)}</ul>
          </div>
          <div>
            <h4>Bentuk kegiatan</h4>
            <ul>{realActivities.map((t) => <li>{t}</li>)}</ul>
          </div>
        </div>
      </section>

      <p class="closing">
        Pembelajaran dilakukan dengan suasana yang menyenangkan agar anak dapat bermain, bereksplorasi, mencoba, dan
        belajar sesuai tahap perkembangannya.
      </p>
    </div>
  </section>

  <section class="section" id="kegiatan" aria-labelledby="kegiatan-title">
    <div class="container">
      <h2 id="kegiatan-title">Kegiatan anak-anak</h2>
      <p class="lead">Dokumentasi kegiatan di dalam dan di luar kelas. Pilih foto untuk melihat lebih besar.</p>
      <div class="gallery-wrap">
        <Gallery items={photos} label="Foto kegiatan TK Tarbiyah Sunnah" />
      </div>
    </div>
  </section>

  <section class="section section--white" id="pendaftaran-tk" aria-labelledby="daftar-tk-title">
    <div class="container enroll">
      <div>
        <h2 id="daftar-tk-title">Pendaftaran TK Tarbiyah Sunnah</h2>
        <p class="lead">Calon murid TK Tarbiyah Sunnah diharapkan memenuhi persyaratan berikut:</p>
        <ol class="steps">{requirements.map((r) => <li>{r}</li>)}</ol>
      </div>
      <aside class="enroll-card" aria-labelledby="ringkas-title">
        <h3 id="ringkas-title">Ringkasan</h3>
        <dl>
          <div>
            <dt>Status pendaftaran</dt>
            <dd>{enrollmentLabel[unit.enrollment]}</dd>
          </div>
          {
            groups.map((g) => (
              <div>
                <dt>{g.name}</dt>
                <dd>Usia {g.age}</dd>
              </div>
            ))
          }
        </dl>
        {
          unit.contact && (
            <>
              <WaButton contact={unit.contact} />
              <p class="muted small">
                Formulir, biaya pendaftaran, dan jadwal observasi dapat ditanyakan melalui WhatsApp{' '}
                {unit.contact.role} di {unit.contact.phone}.
              </p>
            </>
          )
        }
      </aside>
    </div>
  </section>

  <section class="section section--wash" id="kontak-tk" aria-labelledby="kontak-tk-title">
    <div class="container">
      <h2 id="kontak-tk-title">Kontak TK Tarbiyah Sunnah</h2>
      <dl class="contact-grid">
        {
          unit.address && (
            <div>
              <dt>Alamat</dt>
              <dd>{unit.address}</dd>
            </div>
          )
        }
        {
          unit.contact && (
            <div>
              <dt>WhatsApp {unit.contact.role}</dt>
              <dd>
                <a class="tap" href={unit.contact.url} target="_blank" rel="noopener noreferrer">
                  {unit.contact.phone}
                </a>
              </dd>
            </div>
          )
        }
        {
          unit.email && (
            <div>
              <dt>Email</dt>
              <dd>
                <a class="tap" href={`mailto:${unit.email}`}>
                  {unit.email.split('@')[0]}@<wbr />{unit.email.split('@')[1]}
                </a>
              </dd>
            </div>
          )
        }
        {
          unit.instagram && (
            <div>
              <dt>Instagram</dt>
              <dd>
                <a class="tap" href={`https://www.instagram.com/${unit.instagram}/`} target="_blank" rel="noopener noreferrer">
                  @{unit.instagram}
                </a>
              </dd>
            </div>
          )
        }
      </dl>
      {unit.legalStatus && <p class="legal">Status lembaga: {unit.legalStatus}</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .groups {
    display: grid;
    grid-template-columns: 1fr 1fr 0.8fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-top: 2.5rem;
  }

  .group {
    border-top: 3px solid var(--brand);
    padding-top: 1.25rem;
  }

  .group h3 {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .age {
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: 0;
    color: var(--accent-text);
  }

  .group p {
    color: var(--muted);
    margin: 0;
  }

  .note {
    margin-top: 2rem;
    font-size: 0.9375rem;
  }

  .areas {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 clamp(2rem, 5vw, 4rem);
    margin: 2.75rem 0 0;
  }

  .areas div {
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .areas dt {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--brand-deep);
    margin-bottom: 0.4rem;
  }

  .areas dd {
    margin: 0;
    color: var(--muted);
  }

  .thematic {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 1.5rem clamp(2rem, 5vw, 4rem);
    margin-top: 2rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--wash);
    border-radius: 12px;
  }

  .thematic h3 {
    font-size: 1.375rem;
  }

  .thematic p {
    color: var(--muted);
    margin: 0;
  }

  .thematic-lists {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .thematic h4 {
    font-size: 0.9375rem;
    color: var(--brand);
    margin: 0 0 0.5rem;
  }

  .thematic ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  .thematic li + li {
    margin-top: 0.25rem;
  }

  .closing {
    max-width: 40rem;
    margin: 2.5rem 0 0;
    font-size: 1.0625rem;
  }

  .split {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: center;
  }

  .split-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 12px;
  }

  .split h3 {
    font-size: 1.125rem;
    color: var(--brand);
    margin: 1.5rem 0 0.4rem;
  }

  .split p {
    color: var(--muted);
    max-width: 36rem;
  }

  .gallery-wrap {
    margin-top: 2.5rem;
  }

  .enroll {
    display: grid;
    grid-template-columns: 1.3fr 0.9fr;
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: start;
  }

  .steps {
    list-style: none;
    counter-reset: step;
    margin: 2rem 0 0;
    padding: 0;
  }

  .steps li {
    counter-increment: step;
    position: relative;
    padding: 0.9rem 0 0.9rem 3.25rem;
    border-top: 1px solid var(--line);
  }

  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--brand);
    color: #fff;
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .enroll-card {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  .enroll-card h3 {
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
  }

  .enroll-card dl {
    margin: 0 0 1.25rem;
  }

  .enroll-card dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.55rem;
    border-top: 1px solid var(--line);
  }

  .enroll-card dt {
    color: var(--muted);
  }

  .enroll-card dd {
    margin: 0;
    font-weight: 700;
    color: var(--brand-deep);
    text-align: right;
  }

  .enroll-card :global(.btn) {
    width: 100%;
  }

  .small {
    font-size: 0.875rem;
    margin: 0.75rem 0 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
    margin: 2rem 0 0;
  }

  .contact-grid div {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 1.1rem 1.25rem;
  }

  .contact-grid dt {
    font-size: 0.875rem;
    font-weight: 650;
    color: var(--brand);
    margin-bottom: 0.25rem;
  }

  .contact-grid dd {
    margin: 0;
  }

  .legal {
    margin: 1.25rem 0 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .contact-grid a {
    font-weight: 650;
  }

  @media (max-width: 900px) {
    .groups {
      grid-template-columns: 1fr 1fr;
    }

    .schedule-slot {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 760px) {
    .groups,
    .areas,
    .thematic,
    .split,
    .enroll {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 420px) {
    .thematic-lists {
      grid-template-columns: 1fr;
    }
  }
</style>
